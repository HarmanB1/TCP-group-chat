[2173.069973, "o", "\u001b[?2026h\u001b[1;22H\u001b(B\u001b[m\u001b[38;2;0;43;54m\u001b[48;2;101;123;131m| i/client.h \u001b(B\u001b[m\u001b[38;2;0;43;54m\u001b[48;2;133;153;0m README.md \u001b[2;5H\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;7;54;66m# \u001b(B\u001b[0;1m\u001b[38;2;203;75;22m\u001b[48;2;7;54;66mAssignment 11: A Simple Group Chat Server with Fuzzing Clients\u001b[4;5H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mIn this assignment, you will write a simple group chat server program and a client program. The\u001b[5;5Hserver will accept multiple clients and relay client messages back to the clients. Each client, on\u001b[6;5Hthe other hand, will be a \u001b(B\u001b[m\u001b[4:3m\u001b[58:2::220:50:47m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mfuzzer\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m generating messages and sending and receiving those messages to and\u001b[7;5Hfrom the server.\u001b[9;5H\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m## \u001b(B\u001b[0;1m\u001b[38;2;203;75;22m\u001b[48;2;0;43;54mGroup Chat Server\u001b[10;5H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                        \u001b[11;5HThe group chat server accepts client connections, receives client messages, and echoes those\u001b[12;5Hmessages back to all clients. The following are the requirements of the server.\u001b[14;5H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The command-line interface should be able to start the server as follows.\u001b[15;5H\u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[15;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m              \u001b[16;6H\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m ```bash\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m      \u001b[17;7H$ ./server <port number> <# of clients>\u001b[18;6H\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m ```\u001b[19;7H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m            \u001b[20;5H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The executable of your server should be named \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mserver\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.\u001b[21;5H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The server should bind to port \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mport number\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.\u001b[22;5H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m<# of clients>\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m is the expected number of clients.\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 22 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[23;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m A client can join any time and leave any time.                                                \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 23 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[24;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m You do not need to handle cases where this number is just too big and our container cannot    \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 24 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[25;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m   \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[25;10H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m handle that many clients. We will not test with more than 100 clients.                        \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 25 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The server should use \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mAF_INET\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.                                                                  \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m"]
[2173.070012, "o", " \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 26 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The server should bind to all available IP addresses for the local host.                          \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 27 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The server should receive all messages from each and every client as they send them.              \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 28 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m When the server receives a message from a client, it should send the message to \u001b(B\u001b[m\u001b[3m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m*all*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m clients,    \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 29 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[30;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m \u001b(B\u001b[m\u001b[3m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m*including*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m the sender.                                                                           \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 30 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m Message ordering                                                                                  \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 31 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[32;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m When a client sends multiple messages, all clients should receive the messages in the original\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 32 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[33;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m   \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[33;10H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m sending order.                                                                                \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m 33 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[34;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m In addition, all clients should receive all messages in the same order.                       \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;7;54;66m \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m\u001b[K\r\n\u001b(B\u00