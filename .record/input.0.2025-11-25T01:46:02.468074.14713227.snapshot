[2187.792712, "o", "\u001b[?2026h\u001b[53;125H \u001b[2;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m9 \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mdoes not use a fuzzing framework such as [\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::220:50:47m\u001b[38;2;108;113;196m\u001b[48;2;0;43;54mlibFuzzer\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m](\u001b(B\u001b[m\u001b[38;2;42;161;152m\u001b[48;2;0;43;54mhttps://llvm.org/docs/LibFuzzer.html\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m) discussed\u001b[3;2H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m10 \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54min \u001b(B\u001b[m\u001b[4:3m\u001b[58:2::220:50:47m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mA5\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m. The following are the requirements.                                                          \u001b[4;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m1 \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                                          \u001b[5;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m2 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The command-line interface should be able to start a client as follows.\u001b[6;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m3 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[6;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                                                                        \u001b[7;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m4 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[7;6H\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m ```bash\u001b[8;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m5 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[8;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m $ ./client <IP address> <port number> <# of messages> <log file path>\u001b[9;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m6 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[9;6H\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m ```\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                                                                  \u001b[10;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m7 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[10;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m    \u001b[11;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m8 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The executable should be named \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mclient\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.\u001b[12;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m9 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mIP\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m and \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mport\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m are the IP address and the port number of the server, respectively.\u001b[13;2H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m20 \u001b(B\u00