[2182.684781, "o", "[48;2;7;54;66m122 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m After it starts, a client should keep generating and sending random messages. \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m<# of messages>\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m123 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[18;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m should be the number of messages sent.\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m124 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[19;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The random messages should be of type \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m0\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.\r\n\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m125 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[20;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m After sending \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m<# of messages>\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m messages, the client should stop sending type \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m0\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(