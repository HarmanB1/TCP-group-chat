[2188.042774, "o", "\u001b[?2026h\u001b[53;125H \u001b[2;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m2 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The command-line interface should be able to start a client as follows.\u001b[3;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m3 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[3;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                                                                        \u001b[4;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m4 \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m  ```bash\u001b[5;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m5 \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m  $ ./client <IP address> <port number> <# of messages> <log file path>\u001b[6;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m6 \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m  ```\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                                                                  \u001b[7;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m7 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[7;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m    \u001b[8;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m8 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The executable should be named \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mclient\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.\u001b[9;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m9 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mIP\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m and \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mport\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m are the IP address and the port number of the server, respectively.\u001b[10;2H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m20 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m A client should follow the above [\u001b(B\u001b[m\u001b[38;2;108;113;196m\u001b[48;2;0;43;54mmessage protocol\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m](\u001b(B\u001b[m\u001b[38;2;42;161;152m\u001b[48;2;0;43;54m#messaging-protocol\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m) when sending and\u001b[11;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m1 \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m  receiving messages.                                                                      \u001b[12;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m2 \u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m*\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m After it starts, a client should keep generating and sending random messages. \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m<# of messages>\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b[13;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m3 \u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m  should be the number of messages sent.                                                         \u001b[14;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m4 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[14;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m The random messages should be of type \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m0\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m.\u001b[15;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m5 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[15;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m After sending \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m<# of messages>\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m messages, the client should stop sending type \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m0\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m messages,\u001b[16;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m6 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[16;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m "]
[2188.042819, "o", "    and prepare for termination as described below in [\u001b(B\u001b[m\u001b[38;2;108;113;196m\u001b[48;2;0;43;54mTwo-Phase Commit\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                        \u001b[17;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m7 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[17;6H\u001b(B\u001b[m\u001b[38;2;108;113;196m\u001b[48;2;0;43;54m     Protocol\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m](\u001b(B\u001b[m\u001b[38;2;42;161;152m\u001b[48;2;0;43;54m#two-phase-commit-protocol\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m).                             \u001b[18;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m8 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[18;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m You can use \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mgetentropy\u001b(B\u001b[m\u001b[38;2;58;95;205m\u001b[48;2;0;43;54m()\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m to generate random bytes. Read \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mman getentropy\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m to understand how\u001b[19;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m9 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[19;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m     to use it.                                                                                  \u001b[20;2H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m30 \u001b(B\u001b[0;1m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[20;6H\u001b(B\u001b[0;1m\u001b[38;2;38;139;210m\u001b[48;2;0;43;54m   *\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m Since \u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54mgetentropy\u001b(B\u001b[m\u001b[38;2;58;95;205m\u001b[48;2;0;43;54m()\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;0;43;54m`\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m gives you random bytes that you may not be able to print out, use the\u001b[21;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m1 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[21;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m     following function to convert it to a hex string.                                         \u001b[22;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m2 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[22;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m   \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[22;10H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m                                                  \u001b[23;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m3 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[23;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m     ```c\u001b[24;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m4 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[24;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m     #include <stdint.h>\u001b[25;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m5 \u001b(B\u001b[m\u001b[38;2;11;83;101m\u001b[48;2;0;43;54m┆\u001b[25;6H\u001b(B\u001b[m\u001b[38;2;131;148;150m\u001b[48;2;0;43;54m     #include <stdio.h> \u001b[26;3H\u001b(B\u001b[m\u001b[38;2;88;110;117m\u001b[48;2;7;54;66m6 \u001b(B\u00